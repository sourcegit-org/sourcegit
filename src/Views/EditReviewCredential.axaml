<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:SourceGit.Views"
                    x:Class="SourceGit.Views.EditReviewCredential"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.PublishReview.ReviewCredentials}"
                    Width="490" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto">
    <Grid Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}" PointerPressed="BeginMoveWindow"/>
      <TextBlock Classes="bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                 Text="{DynamicResource Text.PublishReview.ReviewCredentials}"/>
      <v:CaptionButtons HorizontalAlignment="Right" IsCloseButtonOnly="True" IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>
    <StackPanel Grid.Row="1" Margin="16" Spacing="8">
      <ComboBox x:Name="Platform" SelectedIndex="0" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="GitLab"/>
        <ComboBoxItem Content="GitHub"/>
      </ComboBox>
      <TextBlock Text="{DynamicResource Text.PublishReview.Server}"/>
      <TextBox x:Name="Server" Watermark="https://github.com"/>
      <TextBlock Text="{DynamicResource Text.PublishReview.Token}"/>
      <TextBox x:Name="Token" PasswordChar="*"/>
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.PublishReview.StoreHelp}"/>
      <TextBlock x:Name="Error" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat" Content="{DynamicResource Text.Cancel}" Click="OnCancel"/>
        <Button Classes="flat primary" Content="{DynamicResource Text.Sure}" Click="OnSave"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
